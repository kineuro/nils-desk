# Editors and operating systems
.DS_Store
*.swp
.idea/
.vscode/

# Build output and environments
target/
dist/
node_modules/
*.log

# Local configuration and secrets never enter the repository
.env
.env.*
!.env.example
*.sqlite
*.db
# the viewer's WASM decoders are copied from their packages at build (web/scripts/codecs.mjs)
web/public/codecs/*.js
web/public/codecs/*.wasm
web/public/codecs/LICENSE-*.txt
!web/public/codecs/decode.worker.js
