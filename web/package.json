    "@cornerstonejs/tools": "^5.8.2",
    "events": "^3.3.0",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "marked": "^18.0.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "temml": "0.13.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.1.1",
